# Copy to .env and fill in. Never commit real secrets.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Runtime role (no superuser, no BYPASSRLS, not table owner)
DATABASE_URL=postgresql://synagogue_app:app_dev_password@localhost:5432/synagogue
# Schema owner – used only by migrations
MIGRATION_DATABASE_URL=postgresql://synagogue_owner:owner_dev_password@localhost:5432/synagogue

# Better Auth
BETTER_AUTH_SECRET=replace-with-32+-random-chars
BETTER_AUTH_URL=http://localhost:3000

# 32-byte key, base64. Encrypts provider credentials stored in the DB. Keep outside the DB.
APP_ENCRYPTION_KEY=

# Provider mode: fake | sandbox | live.  "fake" is refused when NODE_ENV=production.
PROVIDER_MODE=fake
OTP_CHANNEL=fake

# SaaS plan configuration (commercial values are an open business decision – do not invent)
SAAS_PLAN_PRICE_AGOROT=0
SAAS_PLAN_MONTHLY_MESSAGE_QUOTA=500
SAAS_TRIAL_DAYS=30
SAAS_GRACE_DAYS=14
SAAS_EXPORT_ACCESS_DAYS=90

# PayPlus (sandbox/live) – platform-level base URL only; per-synagogue keys are stored encrypted per tenant
PAYPLUS_API_BASE=https://restapidev.payplus.co.il/api/v1.0
# WhatsApp Cloud API
WHATSAPP_API_BASE=https://graph.facebook.com/v21.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
